# Resonance environment. Copy to .env and fill in. Placeholders only; never commit real values.
# Resonance has its own database and secrets; nothing is shared with KEWT.

# Postgres connection string for Resonance's own database
DATABASE_URL=postgres://USER:PASSWORD@HOST:5432/resonance

# Long random string; required in production (e.g. `openssl rand -hex 32`)
SESSION_SECRET=replace-with-a-long-random-string

# Used only to parse imported screenshots (screenshots are sent to OpenAI)
OPENAI_API_KEY=sk-replace-me
# Vision model for screenshot parsing (HANDOFF section 0). Evaluate on real screenshots before relying on it.
OPENAI_VISION_MODEL=gpt-4o-mini

# Daily Brief HRV ranges on the ln(rMSSD) scale (HANDOFF 8.1). Study analysis ignores this.
HRV_LOG_SCALE=true

# Demo data (npm run seed:demo). Leave false on any public server.
ALLOW_DEMO_SEED=false
DEMO_PASSWORD=

# Registration. Empty = the default: closed in production (NODE_ENV=production), open in local dev.
# "true"/"false" override it; set false explicitly on any deployed server.
# While closed, /api/auth/register returns 403 unless the email is on the allowlist.
REGISTRATION_OPEN=
# Comma-separated emails that may register while registration is closed.
REGISTRATION_ALLOWLIST=
