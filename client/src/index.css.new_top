@tailwind base;
@tailwind components;
@tailwind utilities;

/* ══════════════════════════════════════════════════════════════════════
   KEWT BY BLUE EMBER WELLNESS — Design System v3.0
   Inter · Warm Linen · Emerald + Ember · Apple-centered aesthetic
   ══════════════════════════════════════════════════════════════════════ */

/* ── Google Fonts: Inter ──────────────────────────────────────────────
   Loaded here as @import so Vite bundles it. Inter is our Apple SF
   equivalent — screen-optimized, neutral, authoritative.            */
@import url('https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap');

/* ── Light mode ────────────────────────────────────────────────────── */
:root {
  /* Tailwind shadcn tokens */
  --background:        36 20% 97%;     /* warm linen — Blue Ember signature */
  --foreground:        220 20% 12%;
  --card:              0 0% 100%;
  --card-foreground:   220 20% 12%;
  --popover:           0 0% 100%;
  --popover-foreground:220 20% 12%;
  --primary:           158 72% 28%;    /* Emerald */
  --primary-foreground:0 0% 100%;
  --secondary:         36 14% 93%;
  --secondary-foreground:220 15% 30%;
  --muted:             36 14% 93%;
  --muted-foreground:  220 12% 52%;
  --accent:            158 72% 28%;
  --accent-foreground: 0 0% 100%;
  --destructive:       4 76% 48%;
  --destructive-foreground:0 0% 100%;
  --border:            36 12% 88%;
  --input:             36 12% 88%;
  --ring:              158 72% 28%;
  --radius:            0.75rem;

  /* KEWT custom tokens */
  --color-bg:           hsl(36 20% 97%);     /* warm linen */
  --color-surface:      hsl(0 0% 100%);
  --color-surface-2:    hsl(36 16% 98%);
  --color-text:         hsl(220 20% 12%);
  --color-text-muted:   hsl(220 12% 50%);
  --color-text-faint:   hsl(220 8% 70%);
  --color-primary:      hsl(158 72% 28%);    /* Emerald — athlete accent */
  --color-primary-light:hsl(158 55% 92%);
  --color-ember:        hsl(36 91% 50%);     /* Amber ember — brand accent */
  --color-ember-light:  hsl(36 85% 93%);
  --color-border:       hsl(36 12% 88%);
  --color-divider:      hsl(36 10% 91%);
  --color-success:      hsl(158 72% 28%);
  --color-warning:      hsl(36 91% 44%);
  --color-error:        hsl(4 76% 48%);
  --color-blue:         hsl(215 74% 48%);
  --color-purple:       hsl(270 60% 52%);
  --color-orange:       hsl(28 85% 50%);
  --color-gold:         hsl(45 88% 46%);
  --shadow-sm:          0 1px 4px rgba(0,0,0,0.06);
  --shadow-md:          0 4px 16px rgba(0,0,0,0.09);
  --shadow-lg:          0 12px 36px rgba(0,0,0,0.12);
  --transition-interactive: 180ms cubic-bezier(0.16,1,0.3,1);
  --font-sans:          'Inter', system-ui, -apple-system, sans-serif;

  /* Nav dimensions */
  --topnav-height:      60px;
  --page-max:           1120px;
  --page-pad:           28px;
}

/* ── Dark mode ─────────────────────────────────────────────────────── */
[data-theme='dark'] {
  --background:         222 22% 10%;
  --foreground:         220 15% 85%;
  --card:               222 22% 13%;
  --card-foreground:    220 15% 85%;
  --popover:            222 22% 13%;
  --popover-foreground: 220 15% 85%;
  --primary:            158 62% 42%;
  --primary-foreground: 0 0% 100%;
  --secondary:          222 18% 18%;
  --secondary-foreground:220 12% 72%;
  --muted:              222 18% 18%;
  --muted-foreground:   220 10% 55%;
  --accent:             158 62% 42%;
  --accent-foreground:  0 0% 100%;
  --destructive:        4 70% 55%;
  --destructive-foreground:0 0% 100%;
  --border:             222 14% 22%;
  --input:              222 14% 22%;
  --ring:               158 62% 42%;

  --color-bg:           hsl(222 22% 10%);
  --color-surface:      hsl(222 22% 13%);
  --color-surface-2:    hsl(222 20% 16%);
  --color-text:         hsl(220 15% 85%);
  --color-text-muted:   hsl(220 10% 55%);
  --color-text-faint:   hsl(220 8% 38%);
  --color-primary:      hsl(158 62% 42%);
  --color-primary-light:hsl(158 40% 18%);
  --color-ember:        hsl(36 80% 56%);
  --color-ember-light:  hsl(36 60% 18%);
  --color-border:       hsl(222 14% 22%);
  --color-divider:      hsl(222 14% 20%);
  --color-success:      hsl(158 62% 42%);
  --color-warning:      hsl(36 80% 52%);
  --color-error:        hsl(4 70% 55%);
  --color-blue:         hsl(215 65% 58%);
  --color-purple:       hsl(270 55% 62%);
  --color-orange:       hsl(28 80% 58%);
  --color-gold:         hsl(45 80% 54%);
  --shadow-sm:          0 1px 3px rgba(0,0,0,0.25);
  --shadow-md:          0 4px 12px rgba(0,0,0,0.35);
  --shadow-lg:          0 12px 32px rgba(0,0,0,0.4);
}

@media (prefers-color-scheme: dark) {
  :root:not([data-theme]) {
    --background: 222 22% 10%; --foreground: 220 15% 85%;
    --card: 222 22% 13%; --card-foreground: 220 15% 85%;
    --popover: 222 22% 13%; --popover-foreground: 220 15% 85%;
    --primary: 158 62% 42%; --primary-foreground: 0 0% 100%;
    --secondary: 222 18% 18%; --secondary-foreground: 220 12% 72%;
    --muted: 222 18% 18%; --muted-foreground: 220 10% 55%;
    --accent: 158 62% 42%; --accent-foreground: 0 0% 100%;
    --destructive: 4 70% 55%; --destructive-foreground: 0 0% 100%;
    --border: 222 14% 22%; --input: 222 14% 22%; --ring: 158 62% 42%;
    --color-bg: hsl(222 22% 10%); --color-surface: hsl(222 22% 13%);
    --color-surface-2: hsl(222 20% 16%); --color-text: hsl(220 15% 85%);
    --color-text-muted: hsl(220 10% 55%); --color-primary: hsl(158 62% 42%);
    --color-border: hsl(222 14% 22%);
  }
}

/* ── RESET ──────────────────────────────────────────────────────────── */
*, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
html {
  -webkit-font-smoothing: antialiased;
  text-rendering: optimizeLegibility;
  scroll-behavior: smooth;
}
body {
  min-height: 100dvh;
  font-family: var(--font-sans);
  font-size: 15px;
  color: var(--color-text);
  background: var(--color-bg);
  -webkit-font-smoothing: antialiased;
}
img, svg { display: block; max-width: 100%; }
button { cursor: pointer; background: none; border: none; font: inherit; color: inherit; }
input, select, textarea { font: inherit; color: inherit; }
h1,h2,h3,h4,h5,h6 { text-wrap: balance; line-height: 1.2; }
p, li { text-wrap: pretty; max-width: 72ch; }
table { border-collapse: collapse; width: 100%; }

/* ══════════════════════════════════════════════════════════════════════
   KEWT SHELL — Full-height top-nav layout
   ══════════════════════════════════════════════════════════════════════ */

html, body { height: 100%; overflow: hidden; }

.kewt-shell {
  display: flex;
  flex-direction: column;
  height: 100dvh;
}

/* ── Top Navigation ─────────────────────────────────────────────────── */
.kewt-topnav {
  position: sticky;
  top: 0;
  z-index: 100;
  height: var(--topnav-height);
  background: rgba(252,250,247,0.88);   /* warm linen frosted */
  backdrop-filter: blur(20px) saturate(180%);
  -webkit-backdrop-filter: blur(20px) saturate(180%);
  border-bottom: 1px solid transparent;
  transition: border-color 200ms, box-shadow 200ms;
  flex-shrink: 0;
}
[data-theme='dark'] .kewt-topnav {
  background: rgba(17,20,28,0.88);
}
.kewt-topnav--scrolled {
  border-bottom-color: var(--color-border);
  box-shadow: 0 1px 20px rgba(0,0,0,0.06);
}
[data-theme='dark'] .kewt-topnav--scrolled {
  box-shadow: 0 1px 20px rgba(0,0,0,0.3);
}

.kewt-topnav-inner {
  max-width: var(--page-max);
  margin: 0 auto;
  height: 100%;
  padding: 0 var(--page-pad);
  display: grid;
  grid-template-columns: 1fr auto 1fr;
  align-items: center;
  gap: 16px;
}

/* ── Brand (left) ───────────────────────────────────────────────────── */
.kewt-brand {
  display: flex;
  align-items: center;
  gap: 10px;
  text-decoration: none;
  color: inherit;
}
.kewt-brandtext {
  display: flex;
  flex-direction: column;
  line-height: 1.1;
}
.kewt-brandname {
  font-size: 16px;
  font-weight: 800;
  color: var(--color-text);
  letter-spacing: -0.03em;
}
.kewt-brandsub {
  font-size: 10px;
  font-weight: 500;
  color: var(--color-ember);
  letter-spacing: 0.02em;
  text-transform: uppercase;
}

/* ── Center nav links (desktop) ────────────────────────────────────── */
.kewt-nav-center {
  display: flex;
  align-items: center;
  gap: 4px;
}
.kewt-navlink {
  padding: 7px 14px;
  border-radius: 100px;
  font-size: 13.5px;
  font-weight: 500;
  color: var(--color-text-muted);
  text-decoration: none;
  transition: all var(--transition-interactive);
  white-space: nowrap;
  letter-spacing: -0.01em;
}
.kewt-navlink:hover {
  color: var(--color-text);
  background: var(--color-surface-2);
}
.kewt-navlink--active {
  color: var(--color-text);
  background: var(--color-surface);
  font-weight: 600;
  box-shadow: 0 1px 6px rgba(0,0,0,0.08), inset 0 0 0 1px var(--color-border);
}

/* ── Right controls ─────────────────────────────────────────────────── */
.kewt-nav-right {
  display: flex;
  align-items: center;
  justify-content: flex-end;
  gap: 10px;
}

.kewt-theme-btn {
  display: flex;
  align-items: center;
  gap: 5px;
  padding: 6px 13px;
  border-radius: 100px;
  border: 1.5px solid var(--color-border);
  background: var(--color-surface);
  color: var(--color-text-muted);
  font-size: 12.5px;
  font-weight: 600;
  transition: all var(--transition-interactive);
  white-space: nowrap;
}
.kewt-theme-btn:hover {
  color: var(--color-text);
  border-color: var(--color-text-muted);
}

/* ── User chip ───────────────────────────────────────────────────────── */
.kewt-user-chip {
  display: flex;
  align-items: center;
  gap: 7px;
  padding: 4px 10px 4px 4px;
  border-radius: 100px;
  border: 1.5px solid var(--color-border);
  background: var(--color-surface);
  cursor: default;
}
.kewt-avatar {
  width: 28px;
  height: 28px;
  border-radius: 50%;
  background: linear-gradient(135deg, #10b981, #f59e0b);
  color: white;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 12px;
  font-weight: 800;
  flex-shrink: 0;
}
.kewt-avatar--sm { width: 24px; height: 24px; font-size: 10px; }
.kewt-username-sm { font-size: 12.5px; font-weight: 600; color: var(--color-text); }

/* ── Hamburger (mobile only) ────────────────────────────────────────── */
.kewt-hamburger {
  display: none;
  padding: 7px;
  border-radius: 8px;
  color: var(--color-text-muted);
  transition: all var(--transition-interactive);
}
.kewt-hamburger:hover { background: var(--color-surface-2); color: var(--color-text); }

/* ── Main scroll area ────────────────────────────────────────────────── */
.kewt-main {
  flex: 1;
  overflow-y: auto;
  overscroll-behavior: contain;
  background: var(--color-bg);
}

/* ── Global footer ───────────────────────────────────────────────────── */
.kewt-global-footer {
  text-align: center;
  font-size: 10px;
  font-weight: 500;
  color: var(--color-text-faint);
  letter-spacing: 0.04em;
  padding: 8px 0;
  border-top: 1px solid var(--color-divider);
  flex-shrink: 0;
  background: var(--color-bg);
}

/* ── Mobile overlay menu ──────────────────────────────────────────────── */
.kewt-mobile-overlay {
  position: fixed;
  inset: 0;
  background: rgba(0,0,0,0.5);
  backdrop-filter: blur(8px);
  z-index: 200;
  animation: fadeInOverlay 200ms ease;
}
@keyframes fadeInOverlay {
  from { opacity: 0; }
  to   { opacity: 1; }
}
.kewt-mobile-panel {
  position: absolute;
  top: 0; left: 0; right: 0;
  background: var(--color-surface);
  border-bottom: 1px solid var(--color-border);
  border-radius: 0 0 24px 24px;
  padding-bottom: 28px;
  animation: slideDownPanel 280ms cubic-bezier(0.16,1,0.3,1);
  box-shadow: 0 20px 60px rgba(0,0,0,0.18);
}
@keyframes slideDownPanel {
  from { transform: translateY(-20px); opacity: 0; }
  to   { transform: translateY(0);     opacity: 1; }
}
.kewt-mobile-brand {
  display: flex;
  align-items: center;
  gap: 10px;
  padding: 18px 24px 16px;
  border-bottom: 1px solid var(--color-divider);
}
.kewt-mobile-brandname {
  font-size: 17px;
  font-weight: 800;
  color: var(--color-text);
  letter-spacing: -0.03em;
}
.kewt-mobile-brandsub {
  font-size: 12px;
  color: var(--color-ember);
  font-weight: 500;
}
.kewt-mobile-close {
  margin-left: auto;
  padding: 6px;
  border-radius: 8px;
  color: var(--color-text-muted);
  transition: all var(--transition-interactive);
}
.kewt-mobile-close:hover { background: var(--color-divider); color: var(--color-text); }

.kewt-mobile-nav {
  display: flex;
  flex-direction: column;
  padding: 12px 16px;
}
.kewt-mobile-navitem {
  display: block;
  padding: 14px 16px;
  border-radius: 12px;
  font-size: 17px;
  font-weight: 500;
  color: var(--color-text-muted);
  text-decoration: none;
  transition: all var(--transition-interactive);
  letter-spacing: -0.01em;
}
.kewt-mobile-navitem:hover { background: var(--color-surface-2); color: var(--color-text); }
.kewt-mobile-navitem--active {
  color: var(--color-text);
  background: var(--color-primary-light);
  font-weight: 700;
  color: var(--color-primary);
}

.kewt-mobile-footer {
  padding: 16px 24px 0;
  border-top: 1px solid var(--color-divider);
  margin-top: 4px;
}
.kewt-mobile-user {
  display: flex;
  align-items: center;
  gap: 10px;
  margin-bottom: 12px;
}
.kewt-username { font-size: 14px; font-weight: 600; color: var(--color-text); }
.kewt-usermeta { font-size: 11px; color: var(--color-text-muted); }
.kewt-mobile-copyright {
  font-size: 11px;
  color: var(--color-text-faint);
  font-weight: 500;
}

/* ══════════════════════════════════════════════════════════════════════
   KEWT PAGE HERO — Apple centered hero for every page
   Usage: <div className="kewt-page-hero"> ... </div>
   ══════════════════════════════════════════════════════════════════════ */
.kewt-page-hero {
  text-align: center;
  padding: 52px var(--page-pad) 40px;
  max-width: 720px;
  margin: 0 auto;
}
.kewt-page-eyebrow {
  display: inline-flex;
  align-items: center;
  gap: 7px;
  font-size: 11px;
  font-weight: 700;
  text-transform: uppercase;
  letter-spacing: 0.14em;
  color: var(--color-ember);
  margin-bottom: 14px;
}
.kewt-page-eyebrow-dot {
  width: 5px; height: 5px;
  border-radius: 50%;
  background: var(--color-ember);
  animation: pulse-dot 2s ease infinite;
}
@keyframes pulse-dot {
  0%, 100% { opacity: 1; transform: scale(1); }
  50%       { opacity: 0.4; transform: scale(0.7); }
}
.kewt-page-title {
  font-size: clamp(28px, 4vw, 42px);
  font-weight: 800;
  letter-spacing: -0.035em;
  color: var(--color-text);
  line-height: 1.1;
  margin-bottom: 14px;
}
.kewt-page-subtitle {
  font-size: 16px;
  font-weight: 400;
  color: var(--color-text-muted);
  line-height: 1.65;
  max-width: 560px;
  margin: 0 auto;
}
.kewt-page-divider {
  width: 48px;
  height: 2px;
  background: linear-gradient(90deg, var(--color-primary), var(--color-ember));
  border-radius: 2px;
  margin: 24px auto 0;
}

/* ── Page content wrapper ─────────────────────────────────────────── */
.kewt-page-body {
  max-width: var(--page-max);
  margin: 0 auto;
  padding: 0 var(--page-pad) 60px;
}

/* ══════════════════════════════════════════════════════════════════════
   BLUE EMBER INTELLIGENCE BADGE
   Science callout component shared across all pages
   ══════════════════════════════════════════════════════════════════════ */
.bei-badge {
  display: inline-flex;
  align-items: center;
  gap: 6px;
  padding: 4px 10px;
  border-radius: 100px;
  background: linear-gradient(90deg, hsl(158 72% 28% / 0.1), hsl(36 91% 50% / 0.08));
  border: 1px solid hsl(158 72% 28% / 0.18);
  font-size: 10px;
  font-weight: 800;
  text-transform: uppercase;
  letter-spacing: 0.1em;
  color: var(--color-primary);
  margin-bottom: 8px;
}
.bei-flame {
  font-size: 11px;
}
.bei-callout {
  background: linear-gradient(135deg, hsl(158 72% 28% / 0.05), hsl(36 91% 50% / 0.04));
  border: 1px solid hsl(158 72% 28% / 0.14);
  border-radius: 14px;
  padding: 18px 20px;
  margin: 20px 0;
}
.bei-callout-header {
  display: flex;
  align-items: center;
  gap: 8px;
  margin-bottom: 10px;
}
.bei-callout-flame {
  width: 28px; height: 28px;
  background: linear-gradient(135deg, #10b981, #f59e0b);
  border-radius: 7px;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 14px;
  flex-shrink: 0;
}
.bei-callout-label {
  font-size: 10px;
  font-weight: 800;
  text-transform: uppercase;
  letter-spacing: 0.1em;
  color: var(--color-primary);
}
.bei-callout-title {
  font-size: 14px;
  font-weight: 700;
  color: var(--color-text);
}
.bei-callout-body {
  font-size: 13px;
  line-height: 1.65;
  color: var(--color-text-muted);
}

/* ══════════════════════════════════════════════════════════════════════
   LEGACY LAYOUT ALIASES — keep old class names working on existing pages
   ══════════════════════════════════════════════════════════════════════ */

/* Old sidebar layout — now unused, aliased to nothing-harmful */
.dashboard { display: block; }
.sidebar-desktop, .sidebar-mobile, .sidebar-overlay { display: none !important; }
.header { display: none !important; }
.main { display: block; overflow: auto; }

/* ── Old page classes — redirect to new KEWT spacing */
.page, .analytics-page, .weekly-page { padding: 0; }
.log-page { padding: 0; }

/* ── RESPONSIVE ──────────────────────────────────────────────────────── */

/* Tablet: hide user chip text */
@media (max-width: 900px) {
  .kewt-username-sm { display: none; }
  .kewt-user-chip { padding: 4px; }
}

/* Mobile: hide desktop nav, show hamburger */
@media (max-width: 680px) {
  .kewt-nav-center { display: none; }
  .kewt-user-chip  { display: none; }
  .kewt-theme-btn span { display: none; }
  .kewt-theme-btn { padding: 7px; }
  .kewt-hamburger { display: flex; }
  .kewt-topnav-inner {
    grid-template-columns: 1fr auto;
  }
  .kewt-page-hero { padding: 36px 20px 28px; }
  .kewt-page-body { padding: 0 16px 40px; }
  --page-pad: 16px;
}

/* ── UTILITY ─────────────────────────────────────────────────────────── */
.flex-row   { display: flex; align-items: center; gap: 8px; }
.flex-between { display: flex; align-items: center; justify-content: space-between; }
.mt-4 { margin-top: 16px; } .mt-3 { margin-top: 12px; } .mt-2 { margin-top: 8px; }
.mb-4 { margin-bottom: 16px; }
.text-sm { font-size: 13px; } .text-xs { font-size: 11px; }
.text-primary { color: var(--color-primary); }
.text-muted { color: var(--color-text-muted); }
.font-bold { font-weight: 700; } .font-semibold { font-weight: 600; }
.grid-2 { display: grid; grid-template-columns: 1fr 1fr; gap: 16px; }
.full-width { grid-column: 1 / -1; }
.divider { border: none; border-top: 1px solid var(--color-divider); margin: 16px 0; }
.empty-state { text-align: center; padding: 40px 20px; color: var(--color-text-muted); font-size: 13px; }

/* ── CARDS ──────────────────────────────────────────────────────────── */
.card {
  background: var(--color-surface);
  border: 1px solid var(--color-border);
  border-radius: 14px;
  padding: 18px;
  box-shadow: var(--shadow-sm);
}
.card-title { font-size: 12px; font-weight: 600; color: var(--color-text-muted); text-transform: uppercase; letter-spacing: 0.06em; margin-bottom: 10px; display: flex; align-items: center; gap: 6px; }
.card-value { font-size: 28px; font-weight: 700; color: var(--color-text); line-height: 1; font-variant-numeric: tabular-nums; }
.card-unit { font-size: 14px; font-weight: 400; color: var(--color-text-muted); margin-left: 4px; }
.card-delta { font-size: 12px; margin-top: 4px; display: flex; align-items: center; gap: 4px; }
.delta-good { color: var(--color-success); } .delta-warn { color: var(--color-warning); } .delta-bad { color: var(--color-error); }

/* ── KPI / CHARTS GRIDS ─────────────────────────────────────────────── */
.kpi-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(180px, 1fr)); gap: 14px; margin-bottom: 20px; }
.charts-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 16px; margin-bottom: 20px; }
.chart-card { height: 220px; } .chart-inner { width: 100%; height: 160px; }

/* ── INSIGHTS ────────────────────────────────────────────────────────── */
.insights-list { display: flex; flex-direction: column; gap: 8px; }
.insight-item { display: flex; align-items: flex-start; gap: 10px; padding: 10px 12px; background: var(--color-primary-light); border-radius: 8px; font-size: 13px; color: var(--color-text); border-left: 3px solid var(--color-primary); }

/* ── RECOVERY GAUGE ──────────────────────────────────────────────────── */
.recovery-gauge { display: flex; flex-direction: column; align-items: center; gap: 6px; }
.gauge-arc { width: 100px; height: 55px; position: relative; overflow: hidden; }
.gauge-label { font-size: 11px; color: var(--color-text-muted); }

/* ── STREAK BADGES ───────────────────────────────────────────────────── */
.streak-badges { display: flex; gap: 10px; flex-wrap: wrap; }
.streak-badge { display: flex; align-items: center; gap: 6px; padding: 6px 12px; border-radius: 100px; background: var(--color-primary-light); color: var(--color-primary); font-size: 12px; font-weight: 600; }

/* ── FORMS ───────────────────────────────────────────────────────────── */
.log-page { padding: 24px; max-width: 900px; }
.log-tabs { display: flex; gap: 4px; flex-wrap: wrap; margin-bottom: 20px; border-bottom: 1px solid var(--color-divider); padding-bottom: 0; }
.log-tab { padding: 8px 14px; border-radius: 8px 8px 0 0; font-size: 13px; font-weight: 500; color: var(--color-text-muted); cursor: pointer; border: 1px solid transparent; border-bottom: none; transition: all var(--transition-interactive); margin-bottom: -1px; }
.log-tab:hover { color: var(--color-text); background: var(--color-surface); }
.log-tab--active { color: var(--color-primary); background: var(--color-surface); border-color: var(--color-border); border-bottom: 1px solid var(--color-surface); font-weight: 600; }
.log-form { background: var(--color-surface); border: 1px solid var(--color-border); border-radius: 0 12px 12px 12px; padding: 20px; box-shadow: var(--shadow-sm); }
.form-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(200px, 1fr)); gap: 14px; margin-bottom: 16px; }
.form-group { display: flex; flex-direction: column; gap: 5px; }
.form-label { font-size: 12px; font-weight: 600; color: var(--color-text-muted); }
.form-input, .form-select, .form-textarea { padding: 9px 12px; border: 1px solid var(--color-border); border-radius: 8px; background: var(--color-bg); color: var(--color-text); font-size: 14px; transition: border-color var(--transition-interactive); width: 100%; }
.form-input:focus, .form-select:focus, .form-textarea:focus { outline: none; border-color: var(--color-primary); box-shadow: 0 0 0 3px hsl(158 72% 28% / 0.12); }
.form-range { width: 100%; accent-color: var(--color-primary); }
.range-labels { display: flex; justify-content: space-between; font-size: 11px; color: var(--color-text-faint); }
.form-btn { padding: 10px 24px; background: var(--color-primary); color: white; border-radius: 8px; font-size: 14px; font-weight: 600; cursor: pointer; transition: all var(--transition-interactive); }
.form-btn:hover { opacity: 0.9; transform: translateY(-1px); box-shadow: var(--shadow-md); }
.form-btn:active { transform: translateY(0); }
.form-btn:disabled { opacity: 0.5; cursor: not-allowed; transform: none; }
.form-hint { font-size: 11px; color: var(--color-text-faint); margin-top: 2px; }
.checkboxes { display: flex; gap: 8px; flex-wrap: wrap; }
.checkbox-pill { padding: 5px 12px; border: 1px solid var(--color-border); border-radius: 100px; font-size: 12px; cursor: pointer; transition: all var(--transition-interactive); color: var(--color-text-muted); }
.checkbox-pill.active { background: var(--color-primary); border-color: var(--color-primary); color: white; }
.form-section-title { font-size: 15px; font-weight: 700; margin-bottom: 14px; color: var(--color-text); }

/* ── WEEKLY TABLE ────────────────────────────────────────────────────── */
.weekly-page { padding: 24px; }
.weekly-stats-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(140px, 1fr)); gap: 12px; margin-bottom: 20px; }
.weekly-table-wrap { overflow-x: auto; border: 1px solid var(--color-border); border-radius: 12px; margin-bottom: 20px; }
.weekly-table { font-size: 12.5px; font-variant-numeric: tabular-nums; }
.weekly-table th { background: var(--color-surface-2); position: sticky; top: 0; z-index: 1; padding: 10px 12px; text-align: left; font-size: 11px; font-weight: 700; text-transform: uppercase; letter-spacing: 0.05em; color: var(--color-text-muted); border-bottom: 1px solid var(--color-border); white-space: nowrap; }
.weekly-table td { padding: 9px 12px; border-bottom: 1px solid var(--color-divider); color: var(--color-text); white-space: nowrap; }
.weekly-table tr:last-child td { border-bottom: none; }
.weekly-table tr:hover td { background: var(--color-surface-2); }
.pill-yes { background: var(--color-primary-light); color: var(--color-primary); border-radius: 100px; padding: 2px 8px; font-size: 11px; font-weight: 600; }
.pill-no { background: var(--color-divider); color: var(--color-text-faint); border-radius: 100px; padding: 2px 8px; font-size: 11px; }
.score-high { color: var(--color-success); font-weight: 700; } .score-mid { color: var(--color-warning); font-weight: 700; } .score-low { color: var(--color-error); font-weight: 700; }

/* ── GOALS ───────────────────────────────────────────────────────────── */
.goals-grid { display: grid; gap: 14px; grid-template-columns: repeat(auto-fill, minmax(300px, 1fr)); }
.goal-card { padding: 18px; }
.goal-card-header { display: flex; justify-content: space-between; align-items: flex-start; margin-bottom: 12px; }
.goal-badge { font-size: 10px; font-weight: 700; text-transform: uppercase; letter-spacing: 0.06em; padding: 3px 8px; border-radius: 100px; }
.goal-badge--active { background: var(--color-primary-light); color: var(--color-primary); }
.goal-badge--achieved { background: hsl(158 72% 28% / 0.15); color: var(--color-success); }
.goal-progress-bar { width: 100%; height: 8px; background: var(--color-divider); border-radius: 100px; overflow: hidden; margin: 10px 0; }
.goal-progress-fill { height: 100%; background: var(--color-primary); border-radius: 100px; transition: width 0.6s cubic-bezier(0.16,1,0.3,1); }
.goal-meta { font-size: 12px; color: var(--color-text-muted); }
.goal-projection { font-size: 12px; margin-top: 8px; padding: 8px; background: var(--color-primary-light); border-radius: 6px; color: var(--color-text); }
.gcard-inner { display: flex; flex-direction: row; gap: 16px; align-items: flex-start; }
@media (max-width: 540px) { .gcard-inner { flex-direction: column; } }

/* ── ANALYTICS ───────────────────────────────────────────────────────── */
.analytics-page { padding: 24px; }
.correlation-cards { display: grid; gap: 12px; }
.correlation-card { background: var(--color-surface); border: 1px solid var(--color-border); border-radius: 10px; padding: 14px 16px; display: flex; gap: 16px; align-items: center; }
.corr-coefficient { font-size: 22px; font-weight: 700; min-width: 60px; font-variant-numeric: tabular-nums; }
.corr-positive { color: var(--color-success); } .corr-negative { color: var(--color-error); }
.corr-info { flex: 1; }
.corr-metrics { font-size: 12px; font-weight: 600; color: var(--color-text-muted); margin-bottom: 3px; }
.corr-insight { font-size: 13.5px; color: var(--color-text); }
.corr-badge { font-size: 10px; font-weight: 700; padding: 3px 8px; border-radius: 100px; text-transform: uppercase; }
.corr-strong { background: hsl(158 72% 28% / 0.15); color: var(--color-primary); }
.corr-moderate { background: hsl(36 91% 44% / 0.15); color: var(--color-warning); }
.corr-weak { background: var(--color-divider); color: var(--color-text-muted); }
.section-gap { margin-bottom: 24px; }

/* ── RECHARTS OVERRIDES ──────────────────────────────────────────────── */
.recharts-tooltip-wrapper { filter: drop-shadow(var(--shadow-md)); }
.recharts-default-tooltip { background: var(--color-surface) !important; border: 1px solid var(--color-border) !important; border-radius: 8px !important; font-size: 12px !important; color: var(--color-text) !important; }

